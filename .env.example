TMDB_API_KEY=TU_API_KEY_AQUI
# URL pública de TU JSON de servidores (ej. un gist o archivo estático).
# Cada despliegue usa el suyo: nadie depende del de otra persona.
# Si se deja vacío, la app usa el /providers.json local incluido.
# NEXT_PUBLIC_PROVIDERS_URL=https://tu-dominio.com/providers.json
# Para testear cambios sin romper el remoto:
# NEXT_PUBLIC_PROVIDERS_SOURCE=local
# View key de tu panel Vimeus (Settings → General).
# NEXT_PUBLIC_VIMEUS_VIEW_KEY=tu_view_key_aqui
# Secreto del LoveGate / Easter Egg (dedicatoria del footer).
# Privada (sin prefijo NEXT_PUBLIC_): se valida en el servidor.
# EASTER_EGG=lua
