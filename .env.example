TMDB_API_KEY=TU_API_KEY_AQUI
# URL de TU JSON de servidores (ej. un gist o archivo estático).
# Cada despliegue usa el suyo: nadie depende del de otra persona.
# Si se deja vacío, la app usa el /providers.json local incluido.
# PROVIDERS_URL=https://tu-dominio.com/providers.json
# Para testear cambios sin romper el remoto (usa el local):
# PROVIDERS_SOURCE=local
# View key de tu panel Vimeus (inyectada en servidor, nunca al cliente).
# VIMEUS_VIEW_KEY=tu_view_key_aqui
# Secreto del LoveGate / Easter Egg (dedicatoria del footer).
# Privada: se valida en el servidor.
# EASTER_EGG=pass
