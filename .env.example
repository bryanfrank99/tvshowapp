TMDB_API_KEY=TU_API_KEY_AQUI
# URL pública del JSON de proveedores (archivo estático, ej. InfinityFree por FTP).
# Edita ese JSON para agregar/quitar servidores sin tocar la app.
NEXT_PUBLIC_PROVIDERS_URL=https://raw.githubusercontent.com/bryanfrank99/tvlistdata/refs/heads/main/providers.json
# View key de tu panel Vimeus (Settings → General). Solo para servidor Vimeus.
NEXT_PUBLIC_VIMEUS_VIEW_KEY=tu_view_key_aqui
