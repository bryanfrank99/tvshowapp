{
  "name": "tvshow",
  "version": "7.11.0",
  "description": "TVShow Desktop Application for Windows",
  "author": "TVShow Team",
  "private": true,
  "main": "electron/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "cross-env STATIC_EXPORT=1 next build",
    "start": "next start",
    "lint": "next lint",
    "sync": "node scripts/sync-tmdb.mjs",
    "release": "node scripts/release.mjs",
    "build:apk:mobile": "cd android && gradlew assembleMobileDebug",
    "build:apk:tv": "cd android && gradlew assembleTvDebug",
    "build:apks": "cd android && gradlew assembleMobileDebug assembleTvDebug",
    "electron:dev": "electron .",
    "electron:pack": "electron-builder --dir",
    "electron:dist": "electron-builder --win --publish never",
    "test:phase1": "npx tsx scripts/test-phase1-sources.mjs",
    "test:phase2": "npx tsx scripts/test-phase2-resolver.mjs",
    "test:phase3-4": "npx tsx scripts/test-phase3-4-player.mjs",
    "test:phase5": "npx tsx scripts/test-phase5-healthcheck.mjs",
    "test:device-binding": "npx tsx scripts/test-device-binding.mjs",
    "test:new-providers": "npx tsx scripts/test-providers-filmu-stellar.mjs && npx tsx scripts/test-stellar-lang-integration.mjs",
    "test:stellar-lang": "npx tsx scripts/test-stellar-lang-integration.mjs",
    "test:sources": "npm run test:phase1 && npm run test:phase2 && npm run test:phase3-4 && npm run test:phase5",
    "prepare": "husky"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@supabase/supabase-js": "^2.116.0",
    "fast-xml-parser": "^5.11.1",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/node": "^22.20.1",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "cross-env": "^10.1.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "husky": "^9.1.7",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.6",
    "typescript": "5.5.2"
  },
  "build": {
    "appId": "com.tvshow.desktop",
    "productName": "TVShow",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "electron/extensions/**/*"
    ],
    "files": [
      "electron/**/*",
      "resources/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "artifactName": "TVShow-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TVShow",
      "artifactName": "TVShow-Setup-${version}.${ext}"
    }
  }
}
